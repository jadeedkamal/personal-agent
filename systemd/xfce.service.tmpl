[Unit]
Description=XFCE Desktop Session
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:99
Environment=HOME=__HOME__
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/xfce4-session
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
