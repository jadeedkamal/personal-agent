# Copy to ~/.secrets/agent.env (chmod 600) and fill in. install.sh generates most of this for you.

# scrypt "salt:hash" — generate with: node scripts/hash-password.js 'your password'
AGENT_PASSWORD_HASH=

# random 64+ char string — generate with: openssl rand -hex 32
SESSION_SECRET=

# where the agent's "workspace mode" conversations operate (file access, shell cwd)
AGENT_WORKSPACE=/home/YOUR_USER/workspace

PORT=3000

# shared secret between server.js and the gui-control MCP server (must match config/mcp.json)
# generate with: openssl rand -hex 24
INTERNAL_SHARED_SECRET=

# Web Push (optional — enables browser/PWA push notifications). Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google SSO (optional, in addition to the password login). Leave blank to disable.
# Create an OAuth 2.0 Client ID (web application) in Google Cloud Console; redirect URI
# must be https://your-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Only this email is allowed to sign in via Google — required if the above are set.
ALLOWED_GOOGLE_EMAIL=
